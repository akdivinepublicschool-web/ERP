# School ERP - Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Example: mongodb+srv://username:password@cluster.mongodb.net/ak_divine_public_school_erp
MONGO_URI=your_mongodb_uri_here

# Security
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=30d

# File Storage
UPLOAD_PATH=uploads

# Deployed Domain Configuration (Optional in local, required in production)
# BACKEND_URL=http://localhost:5000
# ALLOWED_ORIGINS=http://localhost:5173

# Security & Performance Tuning
# RATE_LIMIT_MAX=100
