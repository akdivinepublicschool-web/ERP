# School ERP - Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Example: mongodb+srv://username:password@cluster.mongodb.net/ak_divine_public_school_erp
MONGO_URI=your_mongodb_uri_here

# Security
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=30d

# File Storage
UPLOAD_PATH=uploads

# CORS & Content Security Policy (comma-separated origins)
# Add every frontend origin allowed to call this backend.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Backend/API origin(s) used by the frontend.
BACKEND_URL=http://localhost:5000
# Optional extra API/websocket origins for CSP connect-src.
# CSP_CONNECT_SRC=https://another-api.example.com

# Security & Performance Tuning
# RATE_LIMIT_MAX=100

# Firebase Admin SDK (Render backend only)
# Recommended: add the JSON as a Render Secret File, then set:
# FCM_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase-service-account.json
# Or store the full JSON in this secure environment variable:
# FCM_SERVICE_ACCOUNT_JSON=
# Alternatively use FCM_PROJECT_ID, FCM_CLIENT_EMAIL and FCM_PRIVATE_KEY.
# Never commit actual Firebase service-account credentials.
