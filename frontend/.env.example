# Production default for Vercel. Add the same key/value in Vercel Environment Variables.
VITE_API_BASE_URL=https://akdivinepublicschool.onrender.com/api

# Firebase Web App configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging Web Push certificate public key
VITE_FIREBASE_VAPID_KEY=
